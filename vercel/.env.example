# Required to protect the serverless API from anonymous use.
APP_PASSWORD=choose-a-long-random-password

# Configure at least one chat provider. Groq is also used for speech transcription.
GROQ_API_KEY=
PRIMARY_LLM=groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Optional fallback provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
